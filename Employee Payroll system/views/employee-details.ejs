<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Employee Details</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f0f2f5;
      min-height: 100vh;
      padding: 30px;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .page-header h2 { font-size: 1.6rem; font-weight: 700; color: #1e3a5f; }

    .header-actions { display: flex; align-items: center; gap: 12px; }

    .btn-search {
      width: 44px; height: 44px;
      border-radius: 50%; border: 1px solid #ccc;
      background: #fff; display: flex; align-items: center;
      justify-content: center; cursor: pointer;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1); transition: box-shadow 0.2s;
    }
    .btn-search:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
    .btn-search svg { width: 18px; height: 18px; color: #555; }

    .btn-add {
      display: flex; align-items: center; gap: 8px;
      background: #7dc142; color: #fff; border: none;
      border-radius: 8px; padding: 11px 22px;
      font-size: 0.97rem; font-weight: 600;
      cursor: pointer; text-decoration: none;
      transition: background 0.2s, transform 0.1s;
    }
    .btn-add:hover { background: #6aad31; }
    .btn-add:active { transform: scale(0.97); }

    .search-bar { display: none; margin-bottom: 16px; }
    .search-bar.active { display: block; }
    .search-bar input {
      width: 100%; max-width: 360px; padding: 9px 16px;
      border: 1px solid #ccc; border-radius: 8px;
      font-size: 0.95rem; outline: none;
    }
    .search-bar input:focus { border-color: #7dc142; }

    .table-card {
      background: #fff; border-radius: 12px;
      overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    }

    table { width: 100%; border-collapse: collapse; }

    thead tr { background: #2f4a5e; color: #fff; }
    thead th {
      padding: 16px 18px; font-size: 0.82rem;
      font-weight: 600; letter-spacing: 0.08em; text-align: left;
    }

    tbody tr { border-bottom: 1px solid #f0f2f5; transition: background 0.15s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #fafbfc; }
    tbody td { padding: 14px 18px; font-size: 0.93rem; color: #333; vertical-align: middle; }

    .name-cell { display: flex; align-items: center; gap: 12px; }

    .name-cell img {
      width: 42px; height: 42px;
      border-radius: 50%; object-fit: cover; flex-shrink: 0;
      border: 2px solid #e0e0e0;
    }

    .avatar-placeholder {
      width: 42px; height: 42px;
      border-radius: 50%; background: #dde3ec;
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem; color: #777; flex-shrink: 0;
      font-weight: 600;
    }

    .badge-list { display: flex; flex-wrap: wrap; gap: 6px; }

    .badge {
      background: #e8f5b0; color: #4a6e0a;
      border-radius: 20px; padding: 3px 12px;
      font-size: 0.78rem; font-weight: 600; white-space: nowrap;
    }

    .salary { font-weight: 500; color: #333; }

    .action-btns { display: flex; align-items: center; gap: 14px; }

    .btn-icon {
      background: none; border: none; cursor: pointer;
      padding: 4px; color: #888; transition: color 0.2s, transform 0.1s;
    }
    .btn-icon:hover { transform: scale(1.15); }
    .btn-icon.delete:hover { color: #e53e3e; }
    .btn-icon.edit:hover   { color: #3b82f6; }
    .btn-icon svg { width: 17px; height: 17px; display: block; }

    .empty-state { text-align: center; padding: 60px 20px; color: #aaa; font-size: 1rem; }

    .pagination {
      display: flex; justify-content: flex-end; align-items: center;
      padding: 16px 20px; gap: 6px; border-top: 1px solid #f0f2f5;
    }

    .page-btn {
      width: 34px; height: 34px; border-radius: 6px;
      border: 1px solid #ddd; background: #fff;
      cursor: pointer; font-size: 0.88rem; color: #555;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s, border-color 0.15s;
    }
    .page-btn:hover, .page-btn.active {
      background: #7dc142; border-color: #7dc142; color: #fff;
    }
  </style>
</head>
<body>

  <%
    function avatarSrc(avatarValue) {
      const map = {
        'avatar1': '/avatar1.jpg',
        'avatar4': '/avatar4.png',
        'avatar2': '/avatar2.jpg',
        'avatar3': '/avatar3.png',
      };
      return map[avatarValue] || null;
    }
  %>

  <!-- Page Header -->
  <div class="page-header">
    <h2>Employee Details</h2>
    <div class="header-actions">
      <button class="btn-search" onclick="toggleSearch()" title="Search">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
        </svg>
      </button>
      <a href="/employees/add" class="btn-add">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" style="width:16px;height:16px;">
          <path stroke-linecap="round" d="M12 4v16M4 12h16"/>
        </svg>
        Add User
      </a>
    </div>
  </div>

  <!-- Search Bar -->
  <div class="search-bar" id="searchBar">
    <input type="text" id="searchInput" placeholder="Search by name, department..." onkeyup="filterTable()" />
  </div>

  <!-- Table -->
  <div class="table-card">
    <table id="employeeTable">
      <thead>
        <tr>
          <th>NAME</th>
          <th>GENDER</th>
          <th>DEPARTMENT</th>
          <th>SALARY</th>
          <th>START DATE</th>
          <th>ACTIONS</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof employees !== 'undefined' && employees.length > 0) { %>
          <% employees.forEach(function(emp) { %>
            <%
              const imgSrc = avatarSrc(emp.avatar);
            %>
            <tr>
              <!-- Name + Avatar -->
              <td>
                <div class="name-cell">
                  <% if (imgSrc) { %>
                    <img src="<%= imgSrc %>" alt="<%= emp.name %>"
                      onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="avatar-placeholder" style="display:none;">
                      <%= emp.name ? emp.name.charAt(0).toUpperCase() : '?' %>
                    </div>
                  <% } else { %>
                    <div class="avatar-placeholder">
                      <%= emp.name ? emp.name.charAt(0).toUpperCase() : '?' %>
                    </div>
                  <% } %>
                  <a href="/employees/<%= emp._id %>/view"
                    style="color:#1e3a5f;text-decoration:none;font-weight:500;">
                    <%= emp.name %>
                  </a>
                </div>
              </td>

              <!-- Gender -->
              <td><%= emp.gender || '—' %></td>

              <!-- Departments -->
              <td>
                <div class="badge-list">
                  <% if (emp.departments && emp.departments.length > 0) { %>
                    <% emp.departments.forEach(function(dept) { %>
                      <span class="badge"><%= dept %></span>
                    <% }); %>
                  <% } else { %>
                    <span style="color:#aaa;">—</span>
                  <% } %>
                </div>
              </td>

              <!-- Salary -->
              <td class="salary">
                <% if (emp.salary) { %>
                  ₹ <%= Number(emp.salary).toLocaleString('en-IN') %>
                <% } else { %>
                  —
                <% } %>
              </td>

              <!-- Start Date -->
              <td>
                <% if (emp.startDay && emp.startMonth && emp.startYear) { %>
                  <%= emp.startDay %> <%= emp.startMonth %> <%= emp.startYear %>
                <% } else { %>
                  —
                <% } %>
              </td>

              <!-- Actions -->
              <td>
                <div class="action-btns">
                  <form action="/employees/<%= emp._id %>/delete" method="POST"
                    onsubmit="return confirm('Delete this employee?')">
                    <button type="submit" class="btn-icon delete" title="Delete">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/>
                      </svg>
                    </button>
                  </form>
                  <a href="/employees/<%= emp._id %>/edit" class="btn-icon edit" title="Edit">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6">
              <div class="empty-state">No employees found. <a href="/employees/add">Add one now →</a></div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>"><button class="page-btn">‹</button></a>
        <% } %>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a href="?page=<%= p %>">
            <button class="page-btn <%= p === currentPage ? 'active' : '' %>"><%= p %></button>
          </a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>"><button class="page-btn">›</button></a>
        <% } %>
      </div>
    <% } %>
  </div>

  <script>
    function toggleSearch() {
      const bar = document.getElementById('searchBar');
      bar.classList.toggle('active');
      if (bar.classList.contains('active')) document.getElementById('searchInput').focus();
    }

    function filterTable() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      document.querySelectorAll('#employeeTable tbody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(query) ? '' : 'none';
      });
    }
  </script>

</body>
</html>